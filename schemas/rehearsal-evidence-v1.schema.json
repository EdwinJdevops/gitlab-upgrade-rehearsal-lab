{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/rehearsal-evidence-v1.schema.json",
  "title": "GitLab Upgrade Rehearsal Evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "source", "target", "environment", "vendor_sources", "assertions", "limitations", "result"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "run_id": {"type": "string", "minLength": 1},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "edition", "state_id"],
      "properties": {
        "version": {"type": "string", "minLength": 1},
        "edition": {"enum": ["ce", "ee"]},
        "state_id": {"type": "string", "minLength": 1}
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version"],
      "properties": {"version": {"type": "string", "minLength": 1}}
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["class", "isolated"],
      "properties": {
        "class": {"const": "linux-package-single-node"},
        "isolated": {"const": true}
      }
    },
    "vendor_sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "uri", "revision"],
        "properties": {
          "name": {"type": "string"},
          "uri": {"type": "string"},
          "revision": {"type": "string"},
          "sha256": {"type": ["string", "null"]}
        }
      }
    },
    "assertions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "summary"],
        "properties": {
          "id": {"type": "string"},
          "status": {"enum": ["VERIFIED", "BLOCKED", "UNKNOWN", "NOT_TESTED", "WARN"]},
          "summary": {"type": "string"},
          "evidence_sha256": {"type": ["string", "null"]}
        }
      }
    },
    "limitations": {"type": "array", "items": {"type": "string"}},
    "result": {"enum": ["rehearsal_passed", "rehearsal_failed", "blocked", "inconclusive"]}
  }
}
